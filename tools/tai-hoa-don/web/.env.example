# Tên miền trỏ về IP của VPS (bản ghi A), ví dụ: hoadon.tanthanhthinh.vn
DOMAIN=hoadon.example.vn

# Tài khoản quản trị đầu tiên (chỉ dùng lần chạy đầu). Để trống mật khẩu → tự tạo, xem bằng: docker compose logs app
TAIHOADON_ADMIN_USER=admin
TAIHOADON_ADMIN_PASSWORD=

# Số lượt đồng bộ chạy cùng lúc (nhiều quá dễ bị cổng thuế chặn tạm thời)
TAIHOADON_MAX_JOBS=4
